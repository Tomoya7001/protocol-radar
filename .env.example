# protocol-radar environment

# REQUIRED. HMAC secret for the hash-chain ledger (F-002). The ledger deliberately
# refuses to append or verify without this set to a non-empty value, and the worker
# refuses to start without it. Use a long random value in production.
PROTOCOL_RADAR_HMAC_SECRET=

# Optional. SQLite database path. Default: ./data/protocol-radar.db
# Use ":memory:" for an ephemeral in-memory database (used by tests).
DATABASE_PATH=./data/protocol-radar.db

# REQUIRED IN PRODUCTION. Canonical public origin of the deployment, used by every
# request-less discovery surface: robots.txt, sitemap.xml and llms.txt. When this is unset
# those routes fall back to http://localhost:3000, which silently breaks crawling and AI
# discovery in production. Set it to the deployment origin WITHOUT a trailing slash.
# Vercel deployments get it from vercel.json; override it there when the custom domain lands.
# NOTE: mcp/server.json hardcodes the same origin for the MCP registry — keep both in sync.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
